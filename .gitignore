# ---------------------------------------------
# 리커버핏 Coach — Git 추적 제외 목록
# 원칙: 개인정보/건강정보/비밀키는 절대 커밋하지 않는다
# ---------------------------------------------

# 의존성 (npm install 로 다시 설치됨)
node_modules/

# Expo 빌드/캐시
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# 네이티브 빌드 산출물
/ios
/android
.kotlin/
*.orig.*

# 서명 키 / 인증서 — 유출되면 앱을 탈취당한다
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# 환경변수 / 비밀값
.env
.env.*
!.env.example

# 사용자 건강정보·테스트 데이터 (절대 업로드 금지)
/local-data/
*.userdata.json
*.survey-dump.json

# Metro
.metro-health-check*

# 로그
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# TypeScript
*.tsbuildinfo

# 에디터 / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.pem
